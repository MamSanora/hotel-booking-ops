fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="6E48366D" w14:textId="45C4D0BF" w:rsidR="007A665A" w:rsidRDefault="00AC2D2E"><w:r><w:t>Since there’s a limit to what can be written into the chat bot, I shall be using this word docx for a series of things I want to implement</w:t></w:r><w:r w:rsidR="000F06B4"><w:rPr><w:rFonts w:hint="cs"/><w:cs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="000F06B4"><w:t>or change</w:t></w:r><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="09C72E68" w14:textId="77777777" w:rsidR="00933943" w:rsidRDefault="00933943"/><w:p w14:paraId="26C75893" w14:textId="059D976F" w:rsidR="003814F5" w:rsidRDefault="00933943"><w:r><w:t>Guidelines when refactoring the codes:</w:t></w:r></w:p><w:p w14:paraId="4349C1D8" w14:textId="4DA0DD0F" w:rsidR="00933943" w:rsidRDefault="00933943"><w:r><w:t xml:space="preserve">- Ensure performance of the system, operational efficiency, and user experience (whether they are either guests, receptionists, or admin) as priority. </w:t></w:r></w:p><w:p w14:paraId="49474575" w14:textId="272ED0E9" w:rsidR="00933943" w:rsidRDefault="00933943"><w:r><w:t>- For example, ease of use, easy to understand, guarantee productivity, and profitability.</w:t></w:r></w:p><w:p w14:paraId="6BABD895" w14:textId="77777777" w:rsidR="00933943" w:rsidRDefault="00933943"/><w:p w14:paraId="7913D883" w14:textId="4704AF98" w:rsidR="000F06B4" w:rsidRDefault="000F06B4"><w:r><w:t xml:space="preserve">1. </w:t></w:r><w:r w:rsidR="00F2656E"><w:t>When rendered in the browser, in the rooms page, remove</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00F2656E"><w:t xml:space="preserve">the </w:t></w:r><w:r><w:t>“Details” button, keeping only the “Book” button since these two basically lead to the same page.</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="149F0EDC" wp14:editId="3509BCE7"><wp:extent cx="4953429" cy="3101609"/><wp:effectExtent l="0" t="0" r="0" b="3810"/><wp:docPr id="1865326208" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1865326208" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId5"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4953429" cy="3101609"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7A3A4021" w14:textId="1D554F26" w:rsidR="00CB179E" w:rsidRDefault="00CB179E"><w:r><w:t xml:space="preserve">2. </w:t></w:r><w:r w:rsidR="00B050FC"><w:t xml:space="preserve">When inputting booking detail, there should be optional options to choose which floor they want, and </w:t></w:r><w:r w:rsidR="00933943"><w:t>a dropdown on whether</w:t></w:r><w:r w:rsidR="00B050FC"><w:t xml:space="preserve"> they want </w:t></w:r><w:r w:rsidR="00933943"><w:t xml:space="preserve">either </w:t></w:r><w:r w:rsidR="00B050FC"><w:t>balcony</w:t></w:r><w:r w:rsidR="00933943"><w:t xml:space="preserve"> view</w:t></w:r><w:r w:rsidR="00B050FC"><w:t>, window</w:t></w:r><w:r w:rsidR="00933943"><w:t xml:space="preserve"> view</w:t></w:r><w:r w:rsidR="00B050FC"><w:t>, or not. Obviously, if it’s not available, guests should be informed immediately that the rooms aren’t available without having to click the proceed to payment button.</w:t></w:r><w:r w:rsidR="00C96A8A"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="45A3C4BD" w14:textId="77777777" w:rsidR="00C96A8A" w:rsidRDefault="00C96A8A"/><w:p w14:paraId="68EB48E4" w14:textId="799BD8D3" w:rsidR="00C96A8A" w:rsidRDefault="00C96A8A"><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">3. In payment page, Remove this </w:t></w:r><w:r w:rsidRPr="00C96A8A"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="3D35747F" wp14:editId="46C300E1"><wp:extent cx="5829805" cy="2110923"/><wp:effectExtent l="0" t="0" r="0" b="3810"/><wp:docPr id="1603173722" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1603173722" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId6"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5829805" cy="2110923"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="0CC1A825" w14:textId="77777777" w:rsidR="00B050FC" w:rsidRDefault="00B050FC"/><w:p w14:paraId="7A13E2CF" w14:textId="49305DF6" w:rsidR="00B050FC" w:rsidRDefault="00C96A8A"><w:r><w:t>4</w:t></w:r><w:r w:rsidR="00B050FC"><w:t>. Hide payment method on guest side and payment method management on admin side. Allow guests to proceed to payment without having to choose payment method. Don’t change anything in the code base.</w:t></w:r></w:p><w:p w14:paraId="11CE0734" w14:textId="77777777" w:rsidR="00E41489" w:rsidRDefault="00E41489"/><w:p w14:paraId="4D70F2D3" w14:textId="68D2EABE" w:rsidR="00E41489" w:rsidRDefault="00E41489"><w:r><w:t xml:space="preserve">5. In this page, the adults and children don’t need dropdown. Instead, it should just tell the guests plainly about the room’s occupancy. </w:t></w:r><w:r w:rsidRPr="00E41489"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="65BA9F51" wp14:editId="342D622C"><wp:extent cx="5943600" cy="3502660"/><wp:effectExtent l="0" t="0" r="0" b="2540"/><wp:docPr id="1878702240" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1878702240" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3502660"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="3BB48F07" w14:textId="5F881AFC" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Standard Room will have occupancy limit for 2 adults and 1 child under age 12, and bed type dropdown that shows Twin or Double.</w:t></w:r></w:p><w:p w14:paraId="05345C2E" w14:textId="1502AD72" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Deluxe Room will have occupancy limit for 2 adults and 1 child under age 12, and bed type dropdown that shows Twin or Double.</w:t></w:r></w:p><w:p w14:paraId="5B5A85C0" w14:textId="62986D26" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Family Triple Room will have occupancy limit for 2 adults and 2 children under age 12.</w:t></w:r></w:p><w:p w14:paraId="7C9CF01C" w14:textId="77777777" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"/><w:p w14:paraId="7A36F6BE" w14:textId="332A48DF" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"><w:r><w:t xml:space="preserve">6. Relevant to point 5, in home page, this box </w:t></w:r><w:r w:rsidR="00933943"><w:t>should have</w:t></w:r><w:r><w:t xml:space="preserve"> adults and children dropdown which will filter the room</w:t></w:r><w:r w:rsidR="00933943"><w:t xml:space="preserve"> type. Add an optional dropdown for whether they want either balcony view, window view, or not.</w:t></w:r><w:r w:rsidR="0000372C"><w:t xml:space="preserve"> Then, remove room type dropdown.</w:t></w:r><w:r w:rsidR="00933943"><w:t xml:space="preserve"> Obviously, the system will remember guests’ data inputs.</w:t></w:r><w:r w:rsidRPr="00E41489"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="09090331" wp14:editId="6024FD0E"><wp:extent cx="5943600" cy="4355465"/><wp:effectExtent l="0" t="0" r="0" b="6985"/><wp:docPr id="169725264" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="169725264" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="4355465"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="3B863798" w14:textId="1A4FEF8B" w:rsidR="0000372C" w:rsidRDefault="0000372C" w:rsidP="0000372C"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Template for adults and children dropdown.</w:t></w:r><w:r w:rsidRPr="0000372C"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="3CBF91DC" wp14:editId="1C4B7001"><wp:extent cx="3673158" cy="2743438"/><wp:effectExtent l="0" t="0" r="3810" b="0"/><wp:docPr id="1158493833" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1158493833" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="3673158" cy="2743438"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="72DF7ACA" w14:textId="77777777" w:rsidR="00E41489" w:rsidRDefault="00E41489" w:rsidP="00E41489"/><w:p w14:paraId="4BAF8778" w14:textId="5ED09381" w:rsidR="00C96A8A" w:rsidRDefault="00933943"><w:r><w:t xml:spac